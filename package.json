  "devDependencies": {
    "@inertiajs/vue3": "^2.3.12",
    "@vitejs/plugin-vue": "^6.0.3",
    "autoprefixer": "^10.4.23",
    "daisyui": "^4.12.24",
    "laravel-vite-plugin": "^2.1.0",
